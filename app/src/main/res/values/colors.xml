<!-- STYLE: light theme palette. Every layout and drawable points to these names;
     values-night/colors.xml overrides the same names for dark mode. -->
<resources>
    <color name="ink">#262626</color> <!-- main text -->
    <color name="muted">#737373</color> <!-- secondary text, hints, icons -->
    <color name="surface">#FFFFFF</color> <!-- card and field background, text on accent buttons -->
    <color name="canvas">#FAFAFA</color> <!-- window background -->
    <color name="line">#DBDBDB</color> <!-- card, field and checkbox borders -->
    <color name="accent">#833AB4</color> <!-- primary button, checked checkbox, system accent -->
    <color name="accent_dark">#6A2C94</color> <!-- accent text and icons (paste, Download, Clear) -->
    <color name="accent_soft">#F5EDFA</color> <!-- paste button, thumbnail circles -->
    <color name="accent_light">#A35BD0</color> <!-- unused (only bg_hero, itself unused) -->
    <color name="accent_soft_pressed">#EBDCF5</color> <!-- paste button pressed -->
    <color name="accent_disabled">#D8C4E8</color> <!-- primary button disabled -->
    <color name="hero_ink">#F8F7FF</color> <!-- unused -->
    <color name="success">#16845B</color> <!-- unused -->
    <color name="error">#B42318</color> <!-- error messages (set from Java) -->
    <color name="scrim">#73000000</color> <!-- dark veil behind the quick download card -->
</resources>
