<!-- STYLE: app theme (light): font, window background, status and navigation bar colors.
     Theme.Instasave.QuickDownload is the translucent sheet opened by the bubble. -->
<resources>
    <style name="Theme.Instasave" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <!-- Sheet shown over Instagram: the app behind stays visible under a scrim. -->
    <style name="Theme.Instasave.QuickDownload">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <!-- No system transition: BubblePopover grows the card out of the bubble and back. -->
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@color/scrim</item>
        <item name="android:navigationBarColor">@color/scrim</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
