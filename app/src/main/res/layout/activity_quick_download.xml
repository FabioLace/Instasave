<!-- STYLE: quick download sheet. Translucent screen opened by the floating bubble: the card is a
     speech bubble placed next to the bubble by BubblePopover.java, which also keeps it clear of the
     "pasted from your clipboard" toast at the bottom. Tapping outside the card closes it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quickRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <!-- Veil over the app behind, color/scrim; fades in and out with the card. -->
    <View
        android:id="@+id/quickScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim" />

    <!-- BLOCK: speech bubble, the card plus its tail. Sizes and position are set in BubblePopover.java. -->
    <FrameLayout
        android:id="@+id/quickPopover"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:visibility="invisible">

    <!-- Card, background drawable/bg_action_card. -->
    <LinearLayout
        android:id="@+id/quickCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_action_card"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Thumbnail, background drawable/bg_thumbnail. -->
            <ImageView
                android:id="@+id/quickPreview"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_thumbnail"
                android:contentDescription="@string/preview_image"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/quickTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/quickMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/quickProgress"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="12dp"
                android:indeterminateTint="@color/accent"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Download button, background drawable/bg_primary. -->
        <Button
            android:id="@+id/quickDownloadButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_primary"
            android:textAllCaps="false"
            android:textColor="@color/surface"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- "Open in Instasave" text button. -->
        <TextView
            android:id="@+id/quickOpenAppButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:text="@string/quick_open_app"
            android:textColor="@color/accent_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Tail pointing at the bubble, drawable/bubble_tail. -->
    <ImageView
        android:id="@+id/quickTail"
        android:layout_width="12dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/bubble_tail" />
    </FrameLayout>
</FrameLayout>
