<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="6dp" android:background="@drawable/bg_history_item" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="14dp">
    <FrameLayout android:layout_width="42dp" android:layout_height="42dp">
        <ImageView android:id="@+id/itemPreview" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_history_icon" android:contentDescription="Anteprima del download" android:scaleType="centerCrop" android:visibility="gone" />
        <TextView android:id="@+id/itemIcon" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_history_icon" android:gravity="center" android:textColor="@color/accent_dark" android:textSize="11sp" android:textStyle="bold" />
    </FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_marginEnd="10dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/itemTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/ink" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/itemMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/muted" android:textSize="13sp" />
    </LinearLayout>
    <TextView android:id="@+id/itemState" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Salvato" android:textColor="@color/success" android:textSize="13sp" android:textStyle="bold" />
</LinearLayout>
