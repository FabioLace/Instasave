<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:orientation="horizontal">
    <TextView android:id="@+id/itemIcon" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_history_icon" android:gravity="center" android:textColor="@color/accent" android:textSize="18sp" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/itemTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/ink" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/itemMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/muted" android:textSize="13sp" />
    </LinearLayout>
    <TextView android:id="@+id/itemState" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Salvato" android:textColor="@color/success" android:textSize="13sp" />
</LinearLayout>
