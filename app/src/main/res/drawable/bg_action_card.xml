<!-- STYLE: white card with thin border, 20dp corners. Shared by the link card, preview card,
     empty history and bubble card (activity_main.xml) and the quick download card. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/surface" />
    <stroke android:width="1dp" android:color="@color/line" />
    <corners android:radius="10dp" />
    <padding android:left="16dp" android:top="16dp" android:right="16dp" android:bottom="16dp" />
</shape>
