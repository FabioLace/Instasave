<!-- STYLE: app theme (dark), overrides values/styles.xml. -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Instasave" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
